---
import { LINKS } from '../../config/links'
import Layout from '../../layouts/Layout.astro'

const base = import.meta.env.BASE_URL
const features = [
  { title: 'Select-to-translate', desc: 'Select any text and get phonetics, part of speech, definitions and examples — add to vocabulary in one click.' },
  { title: 'Hover translation', desc: 'Hover over a word or sentence and read the translation without leaving the page.' },
  { title: 'Full-page translation', desc: 'Bilingual side-by-side paragraphs for the whole page, restorable at any time.' },
  { title: 'Side-panel AI chat', desc: 'Pick a model per provider, attach files or paste screenshots to ask questions.' },
  { title: 'Vocabulary & dictation', desc: 'Auto-saved words with pronunciation; mastery after 3 correct answers in a row, plus listen-and-spell practice.' },
  { title: 'Offline dictionaries', desc: 'ECDICT built in, more dictionaries downloadable, with an online fallback.' },
]
---

<Layout lang="en" title="Mustard · Open-source Chrome translation extension" description="Select, hover and full-page translation with AI chat, vocabulary and offline dictionaries.">
  <header class="sticky top-0 z-10 backdrop-blur bg-paper/80 border-b border-line">
    <nav class="max-w-5xl mx-auto flex items-center gap-4 px-5 h-14">
      <a class="flex items-center gap-2 no-underline text-ink font-700" href={`${base}en/`}>
        <img class="w-7 h-7 rounded-lg" src={`${base}favicon.png`} alt="Mustard">
        Mustard
      </a>
      <span class="flex-1" />
      <a class="text-sm text-muted no-underline hover:text-primary" href={LINKS.repo} target="_blank" rel="noreferrer">GitHub</a>
      <a class="text-sm text-muted no-underline hover:text-primary" href={`${base}`}>中文</a>
    </nav>
  </header>

  <main class="max-w-5xl mx-auto px-5">
    <section class="py-16 text-center">
      <img class="w-20 h-20 mx-auto rounded-2xl" src={`${base}favicon.png`} alt="Mustard">
      <p class="mt-4 chip">Open-source Chrome extension · MIT</p>
      <h1 class="mt-4 text-4xl font-800 tracking-tight">Mustard</h1>
      <p class="mt-4 text-muted leading-relaxed max-w-2xl mx-auto">
        Select / hover / full-page translation, side-panel AI chat, vocabulary with dictation, offline dictionaries.<br>
        Distributed on GitHub only — no store listing.
      </p>
      <div class="mt-8 flex items-center justify-center gap-3">
        <a class="btn-primary" href={LINKS.releases} target="_blank" rel="noreferrer">Install (GitHub)</a>
        <a class="btn-ghost" href={LINKS.repo} target="_blank" rel="noreferrer">Source code</a>
      </div>
      <p class="mt-4 text-xs text-faint">M0 skeleton preview — the full landing page ships in M11.</p>
    </section>

    <section class="pb-20 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {features.map(f => (
        <article class="card">
          <h3 class="mt-0 mb-2 text-base font-700">{f.title}</h3>
          <p class="m-0 text-sm text-muted leading-relaxed">{f.desc}</p>
        </article>
      ))}
    </section>
  </main>

  <footer class="border-t border-line py-8 text-center text-xs text-faint">
    Mustard · MIT · <a class="text-muted no-underline hover:text-primary" href={LINKS.repo} target="_blank" rel="noreferrer">GitHub</a>
  </footer>
</Layout>
