---
/**
 * 粒子背景（对齐 vue-bits Particles 调参面板的效果）：
 * 3D 透视星场 —— 圆点有大有小、近大远小、缓慢漂浮，颜色取当前主题色。
 * Color 取主题色；Count/Spread/Speed/Base Size/Mouse Interaction/
 * Particle Transparency/Disable Rotation/Pixel Ratio 与面板一致。
 * 纯 Canvas 2D 实现，无额外依赖。
 */
interface Props {
  count?: number
  spread?: number
  speed?: number
  baseSize?: number
  mouseInteraction?: boolean
  transparency?: boolean
  disableRotation?: boolean
  pixelRatio?: number
  class?: string
}

const {
  count = 400,
  spread = 10,
  speed = 0.3,
  baseSize = 700,
  mouseInteraction = true,
  transparency = false,
  disableRotation = false,
  pixelRatio = 1,
  class: className = '',
} = Astro.props
---

<canvas
  class:list={['particles', className]}
  data-count={count}
  data-spread={spread}
  data-speed={speed}
  data-base-size={baseSize}
  data-mouse={mouseInteraction ? '1' : '0'}
  data-transparency={transparency ? '1' : '0'}
  data-disable-rotation={disableRotation ? '1' : '0'}
  data-pixel-ratio={pixelRatio}
  aria-hidden="true"
></canvas>

<style>
  .particles {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
  }
</style>

<script>
  interface Particle {
    x: number
    y: number
    z: number
    vx: number
    vy: number
    size: number
    ox: number
    oy: number
  }

  const canvases = document.querySelectorAll<HTMLCanvasElement>('canvas.particles')

  for (const canvas of canvases) {
    const ctx = canvas.getContext('2d')
    if (!ctx)
      continue

    const dpr = Number(canvas.dataset.pixelRatio) || 1
    const count = Number(canvas.dataset.count) || 400
    const spread = Number(canvas.dataset.spread) || 10
    const speed = Number(canvas.dataset.speed) || 0.3
    const baseSize = Number(canvas.dataset.baseSize) || 700
    const mouseInteraction = canvas.dataset.mouse === '1'
    const transparency = canvas.dataset.transparency === '1'
    const disableRotation = canvas.dataset.disableRotation === '1'
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    const Z_NEAR = 1.5
    const Z_FAR = 22
    const FOCAL = 10
    const BASE_R = baseSize / 350
    const ROT = disableRotation || reduced ? 0 : speed * 0.0012

    let width = 0
    let height = 0
    let cx = 0
    let cy = 0
    let unit = 40
    let particles: Particle[] = []
    let color = '#8FCF4A'
    let mouse = { x: -9999, y: -9999 }
    let raf = 0

    function themeColor(): string {
      return getComputedStyle(document.documentElement).getPropertyValue('--m-primary').trim() || '#8FCF4A'
    }

    function seed(): void {
      particles = Array.from({ length: count }, () => ({
        x: (Math.random() * 2 - 1) * spread,
        y: (Math.random() * 2 - 1) * spread,
        z: Z_NEAR + Math.random() * (Z_FAR - Z_NEAR),
        vx: (Math.random() - 0.5) * speed * 0.05,
        vy: (Math.random() - 0.5) * speed * 0.05,
        size: 0.6 + Math.random() * 0.9,
        ox: 0,
        oy: 0,
      }))
    }

    function resize(): void {
      const rect = canvas.getBoundingClientRect()
      width = rect.width
      height = rect.height
      canvas.width = Math.round(width * dpr)
      canvas.height = Math.round(height * dpr)
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0)
      cx = width / 2
      cy = height / 2
      unit = (Math.min(width, height) / (2 * spread)) * 1.6
      color = themeColor()
      seed()
    }

    function onMove(event: MouseEvent): void {
      const rect = canvas.getBoundingClientRect()
      mouse = { x: event.clientX - rect.left, y: event.clientY - rect.top }
    }
    function onLeave(): void {
      mouse = { x: -9999, y: -9999 }
    }

    function frame(): void {
      ctx!.clearRect(0, 0, width, height)
      ctx!.fillStyle = color
      const hoverRadius = 130
      const cos = Math.cos(ROT)
      const sin = Math.sin(ROT)

      for (const p of particles) {
        if (!reduced) {
          p.x += p.vx
          p.y += p.vy
          // 速度缓慢转向，形成柔和漂浮
          const nvx = p.vx * cos - p.vy * sin
          const nvy = p.vx * sin + p.vy * cos
          p.vx = nvx
          p.vy = nvy
          if (p.x > spread) p.x = -spread
          else if (p.x < -spread) p.x = spread
          if (p.y > spread) p.y = -spread
          else if (p.y < -spread) p.y = spread
        }

        const persp = FOCAL / p.z
        const x = cx + p.x * persp * unit
        const y = cy + p.y * persp * unit
        const r = Math.max(0.4, BASE_R * p.size * persp)

        if (x < -r || x > width + r || y < -r || y > height + r)
          continue

        if (mouseInteraction && mouse.x > -9000) {
          const dx = x - mouse.x
          const dy = y - mouse.y
          const dist = Math.hypot(dx, dy)
          if (dist < hoverRadius && dist > 0.01) {
            const force = (1 - dist / hoverRadius) * 22
            p.ox += (dx / dist) * force
            p.oy += (dy / dist) * force
          }
        }
        p.ox *= 0.9
        p.oy *= 0.9

        // 近实远淡，形成层次
        const depth = (p.z - Z_NEAR) / (Z_FAR - Z_NEAR)
        ctx!.globalAlpha = transparency ? 0.15 + (1 - depth) * 0.5 : 1 - depth * 0.72
        ctx!.beginPath()
        ctx!.arc(x + p.ox, y + p.oy, r, 0, Math.PI * 2)
        ctx!.fill()
      }
      ctx!.globalAlpha = 1
      raf = requestAnimationFrame(frame)
    }

    resize()
    window.addEventListener('resize', resize)
    if (mouseInteraction) {
      canvas.parentElement?.addEventListener('mousemove', onMove)
      canvas.parentElement?.addEventListener('mouseleave', onLeave)
    }
    frame()

    document.addEventListener('visibilitychange', () => {
      cancelAnimationFrame(raf)
      if (!document.hidden)
        frame()
    })
  }
</script>
