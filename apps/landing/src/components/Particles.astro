---
/**
 * 粒子背景 —— 3D 星系式旋转：
 * 粒子分布在一个球体内（3D 全方位包围），整体绕一条倾斜轴缓慢自转；
 * 该轴自身再沿一个 360° 圆锥缓慢进动（轨迹为圆）。
 * 鼠标移入后，轴朝鼠标方向的**反方向**轻微偏移。
 * 颜色取当前主题色；纯 Canvas 2D，无额外依赖。
 */
interface Props {
  particleCount?: number
  particleSpread?: number
  speed?: number
  particleColors?: string[]
  moveParticlesOnHover?: boolean
  particleHoverFactor?: number
  alphaParticles?: boolean
  particleBaseSize?: number
  sizeRandomness?: number
  cameraDistance?: number
  disableRotation?: boolean
  pixelRatio?: number
  class?: string
}

const {
  particleCount = 700,
  particleSpread = 10,
  speed = 0.1,
  particleColors,
  moveParticlesOnHover = true,
  particleHoverFactor = 1,
  alphaParticles = true,
  particleBaseSize = 100,
  sizeRandomness = 1,
  cameraDistance = 20,
  disableRotation = false,
  pixelRatio = 1,
  class: className = '',
} = Astro.props
---

<canvas
  class:list={['particles', className]}
  data-count={particleCount}
  data-spread={particleSpread}
  data-speed={speed}
  data-colors={particleColors?.join(',') ?? ''}
  data-hover={moveParticlesOnHover ? '1' : '0'}
  data-hover-factor={particleHoverFactor}
  data-alpha={alphaParticles ? '1' : '0'}
  data-base-size={particleBaseSize}
  data-size-randomness={sizeRandomness}
  data-camera-distance={cameraDistance}
  data-disable-rotation={disableRotation ? '1' : '0'}
  data-pixel-ratio={pixelRatio}
  aria-hidden="true"
></canvas>

<style>
  .particles {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
  }
</style>

<script>
  interface Vec3 { x: number, y: number, z: number }
  interface Particle extends Vec3 {
    scale: number
    alpha: number
    color: string
    ox: number
    oy: number
  }

  /** 绕单位轴 axis 旋转 ang 弧度（Rodrigues） */
  function rotate(v: Vec3, axis: Vec3, ang: number): void {
    const c = Math.cos(ang)
    const s = Math.sin(ang)
    const dot = v.x * axis.x + v.y * axis.y + v.z * axis.z
    const cx = axis.y * v.z - axis.z * v.y
    const cy = axis.z * v.x - axis.x * v.z
    const cz = axis.x * v.y - axis.y * v.x
    v.x = v.x * c + cx * s + axis.x * dot * (1 - c)
    v.y = v.y * c + cy * s + axis.y * dot * (1 - c)
    v.z = v.z * c + cz * s + axis.z * dot * (1 - c)
  }

  function norm(v: Vec3): Vec3 {
    const l = Math.hypot(v.x, v.y, v.z) || 1
    return { x: v.x / l, y: v.y / l, z: v.z / l }
  }

  const canvases = document.querySelectorAll<HTMLCanvasElement>('canvas.particles')

  for (const canvas of canvases) {
    const ctx = canvas.getContext('2d')
    if (!ctx)
      continue

    const count = Number(canvas.dataset.count) || 700
    const spread = Number(canvas.dataset.spread) || 10
    const speed = Number(canvas.dataset.speed) || 0.1
    const hover = canvas.dataset.hover === '1'
    const hoverFactor = Number(canvas.dataset.hoverFactor) || 1
    const alphaParticles = canvas.dataset.alpha === '1'
    const baseSize = Number(canvas.dataset.baseSize) || 100
    const sizeRandomness = Number(canvas.dataset.sizeRandomness) || 0
    const camDistance = Number(canvas.dataset.cameraDistance) || 20
    const disableRotation = canvas.dataset.disableRotation === '1'
    const dpr = Number(canvas.dataset.pixelRatio) || 1
    const customColors = (canvas.dataset.colors || '').split(',').map(s => s.trim()).filter(Boolean)
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    const R = spread / 2
    const spinSpeed = disableRotation || reduced ? 0 : speed * 0.012
    const precessSpeed = disableRotation || reduced ? 0 : speed * 0.004

    // 倾斜的自转轴（呈 3D 视角），并沿圆锥缓慢进动
    const axis0 = norm({ x: 0.55, y: 1, z: 0.3 })
    let axis: Vec3 = { ...axis0 }
    let precess = 0

    let width = 0
    let height = 0
    let cx = 0
    let cy = 0
    let focal = 2000
    let colors: string[] = ['#8FCF4A']
    let particles: Particle[] = []
    let mouse = { x: -9999, y: -9999 }
    let tilt = { x: 0, y: 0 }
    let raf = 0

    function themeColors(): string[] {
      const primary = getComputedStyle(document.documentElement).getPropertyValue('--m-primary').trim() || '#8FCF4A'
      const accent = getComputedStyle(document.documentElement).getPropertyValue('--m-accent').trim() || primary
      return [primary, primary, primary, accent]
    }

    function seed(): void {
      particles = Array.from({ length: count }, () => {
        // 球体内均匀分布（cbrt 保证体积均匀）
        const r = R * Math.cbrt(Math.random())
        const theta = Math.random() * Math.PI * 2
        const phi = Math.acos(2 * Math.random() - 1)
        return {
          x: r * Math.sin(phi) * Math.cos(theta),
          y: r * Math.cos(phi),
          z: r * Math.sin(phi) * Math.sin(theta),
          scale: (1 - sizeRandomness) + sizeRandomness * Math.random(),
          alpha: alphaParticles ? 0.2 + Math.random() * 0.6 : 1,
          color: customColors.length
            ? customColors[Math.floor(Math.random() * customColors.length)]!
            : colors[Math.floor(Math.random() * colors.length)]!,
          ox: 0,
          oy: 0,
        }
      })
    }

    function resize(): void {
      const rect = canvas.getBoundingClientRect()
      width = rect.width
      height = rect.height
      canvas.width = Math.round(width * dpr)
      canvas.height = Math.round(height * dpr)
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0)
      cx = width / 2
      cy = height / 2
      focal = 2 * Math.max(width, height)
      colors = themeColors()
      seed()
    }

    function onMove(event: MouseEvent): void {
      const rect = canvas.getBoundingClientRect()
      mouse = { x: event.clientX - rect.left, y: event.clientY - rect.top }
    }
    function onLeave(): void {
      mouse = { x: -9999, y: -9999 }
    }

    function frame(): void {
      ctx!.clearRect(0, 0, width, height)

      // 自转轴缓慢进动：轴端点绕 Y 轴画一个圆
      if (precessSpeed) {
        precess += precessSpeed
        const a = { ...axis0 }
        rotate(a, { x: 0, y: 1, z: 0 }, precess)
        axis = norm(a)
      }

      // 鼠标：轴朝鼠标反方向轻微偏移
      const targetTilt = { x: 0, y: 0 }
      if (hover && mouse.x > -9000) {
        targetTilt.x = -((mouse.x - cx) / width) * 0.8 * hoverFactor
        targetTilt.y = -((mouse.y - cy) / height) * 0.8 * hoverFactor
      }
      tilt.x += (targetTilt.x - tilt.x) * 0.06
      tilt.y += (targetTilt.y - tilt.y) * 0.06
      const spinAxis = norm({ x: axis.x + tilt.x, y: axis.y + tilt.y, z: axis.z })

      const hoverRadius = 140

      for (const p of particles) {
        if (spinSpeed)
          rotate(p, spinAxis, spinSpeed)

        const depth = camDistance - p.z
        if (depth <= 0.5)
          continue
        const persp = focal / depth
        const x = cx + p.x * persp
        const y = cy + p.y * persp
        const diameter = Math.max(1, baseSize * p.scale / depth)
        const r = diameter / 2

        if (x < -r || x > width + r || y < -r || y > height + r)
          continue

        if (hover && mouse.x > -9000) {
          const dx = x - mouse.x
          const dy = y - mouse.y
          const dist = Math.hypot(dx, dy)
          if (dist < hoverRadius && dist > 0.01) {
            const force = (1 - dist / hoverRadius) * 14 * hoverFactor
            p.ox += (dx / dist) * force
            p.oy += (dy / dist) * force
          }
        }
        p.ox *= 0.9
        p.oy *= 0.9

        // 近实远淡，增强 3D 层次
        const depthRatio = (depth - (camDistance - R)) / spread
        ctx!.globalAlpha = alphaParticles ? p.alpha : 1 - depthRatio * 0.55
        ctx!.fillStyle = p.color
        ctx!.beginPath()
        ctx!.arc(x + p.ox, y + p.oy, r, 0, Math.PI * 2)
        ctx!.fill()
      }
      ctx!.globalAlpha = 1
      raf = requestAnimationFrame(frame)
    }

    resize()
    window.addEventListener('resize', resize)
    if (hover) {
      canvas.parentElement?.addEventListener('mousemove', onMove)
      canvas.parentElement?.addEventListener('mouseleave', onLeave)
    }
    frame()

    document.addEventListener('visibilitychange', () => {
      cancelAnimationFrame(raf)
      if (!document.hidden)
        frame()
    })
  }
</script>
