---
/**
 * 粒子背景（参数对齐 vue-bits Particles 调参面板）：
 * Color 取当前主题色，Count/Spread/Speed/Base Size/Mouse Interaction/
 * Particle Transparency/Disable Rotation/Pixel Ratio 与面板一致。
 * 纯 Canvas 2D 实现，无额外依赖。
 */
interface Props {
  count?: number
  spread?: number
  speed?: number
  baseSize?: number
  mouseInteraction?: boolean
  transparency?: boolean
  disableRotation?: boolean
  pixelRatio?: number
  class?: string
}

const {
  count = 400,
  spread = 10,
  speed = 0.3,
  baseSize = 700,
  mouseInteraction = true,
  transparency = false,
  disableRotation = false,
  pixelRatio = 1,
  class: className = '',
} = Astro.props
---

<canvas
  class:list={['particles', className]}
  data-count={count}
  data-spread={spread}
  data-speed={speed}
  data-base-size={baseSize}
  data-mouse={mouseInteraction ? '1' : '0'}
  data-transparency={transparency ? '1' : '0'}
  data-disable-rotation={disableRotation ? '1' : '0'}
  data-pixel-ratio={pixelRatio}
  aria-hidden="true"
></canvas>

<style>
  .particles {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
  }
</style>

<script>
  interface Particle {
    ang: number
    rad: number
    vr: number
    r: number
    alpha: number
    ox: number
    oy: number
  }

  const canvases = document.querySelectorAll<HTMLCanvasElement>('canvas.particles')

  for (const canvas of canvases) {
    const ctx = canvas.getContext('2d')
    if (!ctx)
      continue

    const dpr = Number(canvas.dataset.pixelRatio) || 1
    const count = Number(canvas.dataset.count) || 400
    const spread = Number(canvas.dataset.spread) || 10
    const speed = Number(canvas.dataset.speed) || 0.3
    const baseSize = Number(canvas.dataset.baseSize) || 700
    const mouseInteraction = canvas.dataset.mouse === '1'
    const transparency = canvas.dataset.transparency === '1'
    const disableRotation = canvas.dataset.disableRotation === '1'
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    // Base Size 700 ≈ 1.75px 半径；speed 0.3 时旋转非常缓慢
    const radius = Math.max(0.6, baseSize / 400)
    const rotSpeed = disableRotation || reduced ? 0 : speed * 0.0009
    const driftSpeed = speed * 0.02

    let width = 0
    let height = 0
    let cx = 0
    let cy = 0
    let maxR = 0
    let particles: Particle[] = []
    let color = '#8FCF4A'
    let mouse = { x: -9999, y: -9999 }
    let raf = 0

    function themeColor(): string {
      return getComputedStyle(document.documentElement).getPropertyValue('--m-primary').trim() || '#8FCF4A'
    }

    function seed(): void {
      particles = Array.from({ length: count }, () => ({
        ang: Math.random() * Math.PI * 2,
        // sqrt 保证面积上均匀分布
        rad: Math.sqrt(Math.random()) * maxR,
        vr: (Math.random() - 0.5) * driftSpeed,
        r: radius * (0.7 + Math.random() * 0.6),
        alpha: transparency ? 0.15 + Math.random() * 0.55 : 0.85,
        ox: 0,
        oy: 0,
      }))
    }

    function resize(): void {
      const rect = canvas.getBoundingClientRect()
      width = rect.width
      height = rect.height
      canvas.width = Math.round(width * dpr)
      canvas.height = Math.round(height * dpr)
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0)
      cx = width / 2
      cy = height / 2
      maxR = Math.hypot(width, height) / 2
      color = themeColor()
      seed()
    }

    function onMove(event: MouseEvent): void {
      const rect = canvas.getBoundingClientRect()
      mouse = { x: event.clientX - rect.left, y: event.clientY - rect.top }
    }
    function onLeave(): void {
      mouse = { x: -9999, y: -9999 }
    }

    function frame(): void {
      ctx!.clearRect(0, 0, width, height)
      ctx!.fillStyle = color
      const hoverRadius = 130

      for (const p of particles) {
        if (!reduced) {
          p.ang += rotSpeed
          p.rad += p.vr
          if (p.rad > maxR + spread || p.rad < spread * 0.5)
            p.vr *= -1
        }
        const x = cx + Math.cos(p.ang) * p.rad
        const y = cy + Math.sin(p.ang) * p.rad

        if (mouseInteraction && mouse.x > -9000) {
          const dx = x - mouse.x
          const dy = y - mouse.y
          const dist = Math.hypot(dx, dy)
          if (dist < hoverRadius && dist > 0.01) {
            const force = (1 - dist / hoverRadius) * 26
            p.ox += (dx / dist) * force
            p.oy += (dy / dist) * force
          }
        }
        p.ox *= 0.9
        p.oy *= 0.9

        ctx!.globalAlpha = p.alpha
        ctx!.beginPath()
        ctx!.arc(x + p.ox, y + p.oy, p.r, 0, Math.PI * 2)
        ctx!.fill()
      }
      ctx!.globalAlpha = 1
      raf = requestAnimationFrame(frame)
    }

    resize()
    window.addEventListener('resize', resize)
    if (mouseInteraction) {
      canvas.parentElement?.addEventListener('mousemove', onMove)
      canvas.parentElement?.addEventListener('mouseleave', onLeave)
    }
    frame()

    document.addEventListener('visibilitychange', () => {
      cancelAnimationFrame(raf)
      if (!document.hidden)
        frame()
    })
  }
</script>
