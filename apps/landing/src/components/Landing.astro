---
import type { Locale } from '../config/links'
import { CONTENT } from '../config/content'
import { BASE, LINKS } from '../config/links'
import Layout from '../layouts/Layout.astro'
import Particles from './Particles.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const c = CONTENT[locale]
const base = BASE
const altHref = locale === 'zh' ? `${base}en/` : base

/** 真实产品截图（由扩展在深色主题下实拍）；uniform 表示与截图翻译统一宽度 */
const SHOTS: Partial<Record<string, { src: string, w: number, h: number, uniform?: boolean }>> = {
  selection: { src: 'shots/selection.png', w: 788, h: 444 },
  hover: { src: 'shots/hover.png', w: 714, h: 318 },
  page: { src: 'shots/page.png', w: 1400, h: 1040 },
  image: { src: 'shots/image.png', w: 840, h: 1240, uniform: true },
  chat: { src: 'shots/chat.png', w: 840, h: 1240, uniform: true },
  vocab: { src: 'shots/vocab.png', w: 840, h: 1240, uniform: true },
  dict: { src: 'shots/dict.png', w: 1140, h: 1222, uniform: true },
  providers: { src: 'shots/providers.png', w: 1048, h: 1210, uniform: true },
}
---

<Layout lang={c.lang} title={c.title} description={c.description}>
  <header class="site-header sticky top-0 z-20">
    <nav class="max-w-5xl mx-auto flex items-center gap-5 px-5 h-14">
      <a class="flex items-center gap-2 no-underline text-ink font-700" href={base}>
        <img class="w-7 h-7 rounded-lg" src={`${base}icon.svg`} alt="Mustard">
        <span>{c.hero.title}</span>
      </a>
      <span class="flex-1" />
      <a class="nav-link hidden sm:inline" href="#features">{c.nav.features}</a>
      <a class="nav-link hidden sm:inline" href="#steps">{c.nav.steps}</a>
      <a class="nav-link hidden sm:inline" href="#install">{c.nav.install}</a>
      <a class="nav-link" href={LINKS.repo} target="_blank" rel="noreferrer">{c.nav.github}</a>
      <a class="nav-link" href={altHref}>{c.nav.altLabel}</a>
    </nav>
  </header>

  <main>
    <!-- Hero -->
    <section class="hero">
      <Particles
        class="hero-particles"
        particleCount={400}
        particleSpread={10}
        speed={0.1}
        particleBaseSize={100}
        sizeRandomness={1}
        cameraDistance={20}
        alphaParticles={true}
        disableRotation={false}
        moveParticlesOnHover={true}
        pixelRatio={1}
      />
      <div class="hero-inner max-w-5xl mx-auto px-5 pt-16 pb-12 text-center">
        <img class="w-20 h-20 mx-auto rounded-2xl shadow-md" src={`${base}icon.svg`} alt="Mustard">
        <p class="hero-badge">{c.hero.badge}</p>
        <h1 class="mt-4 text-4xl sm:text-5xl font-800 tracking-tight">
          {c.hero.title}<span class="hero-slogan">{c.hero.slogan}</span>
        </h1>
        <p class="mt-4 text-muted leading-relaxed max-w-2xl mx-auto">{c.hero.tagline}</p>
        <div class="mt-8 flex items-center justify-center gap-3 flex-wrap">
          <a class="btn-primary" href={LINKS.releases} target="_blank" rel="noreferrer">{c.hero.install}</a>
          <a class="btn-ghost" href={LINKS.repo} target="_blank" rel="noreferrer">{c.hero.source}</a>
        </div>

        <div class="mt-10 mock-window hero-window text-left">
          <div class="mock-bar">
            <span class="mock-dots"><i /><i /><i /></span>
            <span class="mock-url">en.wikipedia.org</span>
          </div>
          <img class="mock-shot" src={`${base}shots/page-hero.png`} width="2000" height="1172" alt="网页翻译：整页双语对照，含导航、正文与信息框">
        </div>
      </div>
    </section>

    <!-- Features -->
    <section id="features" class="max-w-5xl mx-auto px-5 py-14">
      <h2 class="section-title">{c.featuresTitle}</h2>
      <div class="flex flex-col gap-12 mt-10">
        {c.features.map((f, i) => (
          <article class:list={['feature', i % 2 === 1 && 'feature-reverse']}>
            <div class="feature-text">
              <h3>{f.title}</h3>
              <p>{f.desc}</p>
            </div>
            <div class="feature-visual">
              {SHOTS[f.visual]
                ? (
                    <img
                      class:list={['shot', SHOTS[f.visual]!.uniform && 'shot-uniform']}
                      src={`${base}${SHOTS[f.visual]!.src}`}
                      width={SHOTS[f.visual]!.w}
                      height={SHOTS[f.visual]!.h}
                      alt={f.title}
                      loading="lazy"
                    />
                  )
                : null}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Steps -->
    <section id="steps" class="bg-surface-2 border-y border-line">
      <div class="max-w-5xl mx-auto px-5 py-14">
        <h2 class="section-title">{c.stepsTitle}</h2>
        <div class="grid gap-4 sm:grid-cols-3 mt-10">
          {c.steps.map(s => (
            <div class="card step">
              <span class="step-n">{s.n}</span>
              <h3 class="mt-3 mb-2 text-base font-700">{s.title}</h3>
              <p class="m-0 text-sm text-muted leading-relaxed">{s.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- More -->
    <section class="max-w-5xl mx-auto px-5 py-14">
      <h2 class="section-title">{c.moreTitle}</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 mt-10">
        {c.more.map(m => (
          <article class="card">
            <h3 class="mt-0 mb-2 text-base font-700">{m.title}</h3>
            <p class="m-0 text-sm text-muted leading-relaxed">{m.desc}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- Install -->
    <section id="install" class="max-w-5xl mx-auto px-5 py-14">
      <h2 class="section-title">{c.installTitle}</h2>
      <p class="mt-3 text-muted">{c.installDesc}</p>
      <div class="grid gap-5 sm:grid-cols-2 mt-8">
        {c.installOptions.map(o => (
          <div class="card install-card">
            <h3 class="mt-0 mb-1 text-base font-700">{o.title}</h3>
            <p class="m-0 mb-4 text-sm text-muted">{o.desc}</p>
            {o.kind === 'steps'
              ? (
                  <ol class="install-steps">
                    {o.steps.map(step => (
                      <li>
                        <code class="install-cmd">{step.cmd}</code>
                        <span class="install-note">{step.note}</span>
                      </li>
                    ))}
                  </ol>
                )
              : (
                  <>
                    <div class="install-code">
                      <div class="code-bar"><i /><i /><i /></div>
                      <pre class="code-body">{o.code.map(line => <span class="code-line">{line}</span>)}</pre>
                    </div>
                    <p class="install-note code-note">{o.note}</p>
                  </>
                )}
          </div>
        ))}
      </div>
    </section>

    <!-- Open source -->
    <section class="bg-surface-2 border-y border-line">
      <div class="max-w-3xl mx-auto px-5 py-14 text-center">
        <h2 class="section-title">{c.ossTitle}</h2>
        <p class="mt-4 text-muted leading-relaxed">{c.ossDesc}</p>
        <div class="mt-6 flex justify-center gap-3 flex-wrap">
          <a class="btn-ghost" href={LINKS.repo} target="_blank" rel="noreferrer">GitHub</a>
          <a class="btn-ghost" href={LINKS.issues} target="_blank" rel="noreferrer">Issues</a>
          <a class="btn-ghost" href={LINKS.license} target="_blank" rel="noreferrer">MIT License</a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
/* 毛玻璃导航：模糊半径与底色不透明度都压得较低，
   否则会把「小尺寸 + 低透明度」的粒子完全抹平，交界处出现硬切边 */
.site-header {
  background: color-mix(in srgb, var(--m-paper) 52%, transparent);
  -webkit-backdrop-filter: blur(4px) saturate(180%);
  backdrop-filter: blur(4px) saturate(180%);
  border-bottom: 1px solid color-mix(in srgb, var(--m-line) 55%, transparent);
}
@supports not (backdrop-filter: blur(1px)) {
  .site-header { background: var(--m-paper); }
}
.nav-link { font-size: .875rem; color: var(--m-muted); text-decoration: none; transition: color .15s; text-shadow: 0 1px 3px color-mix(in srgb, var(--m-paper) 75%, transparent); }
.nav-link:hover { color: var(--m-primary); }
.section-title { font-size: 1.6rem; font-weight: 800; margin: 0; letter-spacing: -.02em; }
.hero-badge {
  margin: 1.25rem 0 0;
  font-size: 18px;
  font-weight: 600;
  color: var(--m-primary);
}
.hero-slogan {
  margin-left: .35em;
  font-size: 1em;
  font-weight: 800;
  color: var(--m-primary);
}

/* hero 上探到导航栏下方（-h-14-1px 的边框），让粒子从页面最顶端开始铺，
   配合毛玻璃导航即可透出粒子；padding 抵消，内容位置不变 */
.hero {
  position: relative;
  overflow: hidden;
  margin-top: calc(-3.5rem - 1px);
  padding-top: calc(3.5rem + 1px);
}
.hero-inner { position: relative; z-index: 1; }
.hero-particles { position: absolute; inset: 0; z-index: 0; }
.hero .mock-window { background: var(--m-surface); }
/* 主图铺满页面主体宽度（与 max-w-5xl 内容区等宽） */
.hero .hero-window { max-width: none; }
.mock-shot {
  display: block;
  width: 100%;
  height: auto;
  /* 固定比例 + cover，保证图片始终铺满窗口（不出现留白） */
  aspect-ratio: 2000 / 1172;
  object-fit: cover;
}

.feature-visual { display: flex; justify-content: center; }
.shot {
  display: block;
  margin: 0 auto;
  width: auto;
  height: auto;
  max-width: 100%;
  max-height: 460px;
  border: 1px solid var(--m-line);
  border-radius: 14px;
  background: var(--m-surface);
  box-shadow: var(--m-shadow-md);
}
/* 截图翻译 ~ 模型提供商：统一宽度 */
.shot.shot-uniform {
  width: 300px;
  max-height: none;
}

.feature { display: grid; gap: 22px; align-items: center; }
@media (min-width: 768px) {
  .feature { grid-template-columns: 1fr 1.1fr; }
  .feature-reverse .feature-text { order: 2; }
}
.feature-text h3 { font-size: 1.15rem; font-weight: 700; margin: 0 0 8px; }
.feature-text p { margin: 0; color: var(--m-muted); line-height: 1.7; font-size: .95rem; }

.mock-window {
  border: 1px solid var(--m-line);
  border-radius: 14px;
  background: var(--m-surface);
  overflow: hidden;
  box-shadow: var(--m-shadow-md);
  margin-inline: auto;
  max-width: 560px;
}
.mock-bar { display: flex; align-items: center; gap: 8px; padding: 8px 12px; background: var(--m-surface-2); border-bottom: 1px solid var(--m-line); }
.mock-dots { display: inline-flex; gap: 5px; }
.mock-dots i { width: 9px; height: 9px; border-radius: 50%; background: var(--m-faint); display: block; }
.mock-url { font-size: 11px; color: var(--m-muted); }
.mock-body { position: relative; padding: 16px; }
.mock-p { margin: 0 0 6px; font-size: .92rem; line-height: 1.7; color: var(--m-ink); }
.mock-tr { margin: 0 0 12px; font-size: .92rem; line-height: 1.7; color: var(--m-muted); padding-left: 10px; border-left: 2px solid var(--m-primary); }
.mock-body mark { background: var(--m-primary-soft); color: var(--m-primary); border-radius: 4px; padding: 0 3px; }
.mock-body mark.soft { background: var(--m-blush); color: #fff; }
.mock-ball { position: absolute; right: 12px; bottom: 12px; width: 34px; height: 34px; border-radius: 50%; background: linear-gradient(135deg, var(--m-primary), #A8D96B); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 16px; box-shadow: var(--m-shadow-md); }

.mock-pop { margin-top: 10px; border: 1px solid var(--m-line); border-radius: 10px; padding: 10px 12px; background: var(--m-surface); box-shadow: var(--m-shadow-md); }
.mock-ph { color: var(--m-faint); font-size: 12px; margin-left: 6px; }
.mock-tr2 { margin: 6px 0; font-size: .88rem; }
.mock-btns { display: flex; gap: 8px; font-size: 11px; color: var(--m-primary); }
.mock-tip { margin-top: 12px; display: inline-block; background: var(--m-ink); color: var(--m-paper); border-radius: 8px; padding: 6px 10px; font-size: 12px; }

.mock-img { height: 84px; border: 1px dashed var(--m-line); border-radius: 10px; display: flex; align-items: center; justify-content: center; color: var(--m-faint); font-size: 12px; margin-bottom: 10px; }
.mock-chat { display: flex; flex-direction: column; gap: 8px; }
.mock-bubble { margin: 0; padding: 8px 10px; border-radius: 10px; font-size: .85rem; line-height: 1.5; max-width: 85%; }
.mock-bubble.user { align-self: flex-end; background: var(--m-primary); color: var(--m-primary-ink); }
.mock-bubble.ai { align-self: flex-start; background: var(--m-surface-2); color: var(--m-ink); }
.mock-input { margin-top: 4px; border: 1px solid var(--m-line); border-radius: 8px; padding: 7px 10px; font-size: 12px; color: var(--m-faint); display: flex; justify-content: space-between; }

.mock-vocab, .mock-dict { display: flex; flex-direction: column; gap: 8px; }
.mock-row { display: flex; justify-content: space-between; align-items: center; font-size: .88rem; border-bottom: 1px solid var(--m-line); padding-bottom: 6px; }
.mock-stars { color: var(--m-warn); letter-spacing: 2px; }
.mock-mastered { background: var(--m-primary-soft); color: var(--m-primary); border-radius: 999px; padding: 2px 8px; font-size: 11px; font-weight: 600; }
.mock-chain { margin: 0; padding-left: 18px; color: var(--m-muted); font-size: .88rem; line-height: 1.9; }
.mock-chain b { color: var(--m-primary); }
.mock-prov { display: flex; flex-direction: column; gap: 10px; }
.mock-prov-head { display: flex; align-items: center; gap: 6px; font-size: .92rem; font-weight: 600; }
.mock-prov-head i { width: 8px; height: 8px; border-radius: 50%; background: var(--m-primary); }
.mock-chips { display: flex; flex-wrap: wrap; gap: 6px; }
.mock-chips span { font-size: 11px; border: 1px solid var(--m-line); border-radius: 7px; padding: 3px 8px; color: var(--m-muted); }
.mock-chips span.on { background: var(--m-primary-soft); color: var(--m-primary); border-color: transparent; }

.step-n { font-size: 1.4rem; font-weight: 800; color: var(--m-primary); }

.install-card { display: flex; flex-direction: column; }
.install-steps { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; counter-reset: install; }
.install-steps li { display: grid; grid-template-columns: auto auto 1fr; grid-template-areas: "n code note"; column-gap: 12px; align-items: start; }
.install-steps li::before {
  grid-area: n;
  counter-increment: install;
  content: counter(install);
  font-size: .78rem;
  font-weight: 700;
  line-height: 1.5;
  color: var(--m-faint);
  padding-top: 4px;
}
.install-cmd {
  grid-area: code;
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: .8rem;
  line-height: 1.5;
  padding: 3px 8px;
  border: 1px solid var(--m-line);
  border-radius: 6px;
  background: var(--m-surface-2);
  color: var(--m-primary);
  white-space: nowrap;
}
.install-note { grid-area: note; font-size: .82rem; line-height: 1.5; color: var(--m-muted); }

.install-code { border: 1px solid var(--m-line); border-radius: 10px; overflow: hidden; background: rgba(0, 0, 0, .3); }
.code-bar { display: flex; gap: 5px; padding: 7px 10px; border-bottom: 1px solid var(--m-line); background: rgba(255, 255, 255, .03); }
.code-bar i { width: 8px; height: 8px; border-radius: 50%; background: var(--m-faint); opacity: .55; display: block; }
.code-body { margin: 0; padding: 11px 12px; display: flex; flex-direction: column; gap: 7px; }
.code-line {
  display: block;
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: .78rem;
  line-height: 1.5;
  color: var(--m-primary);
  white-space: pre-wrap;
  word-break: break-all;
}
.code-note { margin: 12px 0 0; }
</style>
